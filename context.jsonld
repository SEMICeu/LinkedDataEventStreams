{
  "@context": {
      "ldes": "https://w3id.org/ldes#",
      "dcat": "http://www.w3.org/ns/dcat#",
      "shape": { "@type":"@id", "@id":"ldes:shape"},
      "xsd": "http://www.w3.org/2001/XMLSchema#",
      "EventStream": "ldes:EventStream",
      "RetentionPolicy": "ldes:RetentionPolicy",
      "Page": "ldes:Page",
      "Relation": "ldes:Relation",
      "page": {"@type": "@id", "@id": "ldes:page"},
      "member": {"@type": "@id", "@id": "ldes:member"},
      "relation": {"@type": "@id", "@id": "ldes:relation"},
      "timeFrom": {"@id": "ldes:timeFrom", "@type": "xsd:dateTime"},
      "timeUntil": {"@id": "ldes:timeUntil", "@type": "xsd:dateTime"},
      "pageNumber": {"@id": "ldes:pageNumber", "@type": "xsd:nonNegativeInteger"},
      "pageNumberUntil": {"@id": "ldes:pageNumberUntil", "@type": "xsd:nonNegativeInteger"},
      "sequenceFrom": {"@id": "ldes:sequenceFrom"},
      "sequenceUntil": {"@id": "ldes:sequenceUntil"},
      "memberGraph": {"@id": "ldes:memberGraph", "@type": "xsd:boolean"},
      "memberType": {"@id": "ldes:memberType", "@type": "@id"},
      "memberPath": {"@id": "ldes:memberPath", "@type": "@id", "@container": "@list"},
      "sequencePath": {"@id":"ldes:sequencePath", "@type":"@id", "@container":"@list"},
      "immutable": {"@id": "ldes:immutable"},
      "timestampPath": {"@id":"ldes:timestampPath", "@type":"@id", "@container":"@list"},
      "defaultTimezone": {"@id":"ldes:defaultTimezone"},
      "versionOfPath": {"@id":"ldes:versionOfPath", "@type":"@id", "@container":"@list"},
      "retentionPolicies": {"@id":"ldes:retentionPolicy", "@type": "@id", "@container":"@list"},
      "pollingInterval": {"@id":"ldes:pollingInterval", "@type":"xsd:integer"},
      "versionKey": {"@id":"ldes:versionKey", "@type":"@id", "@container":"@list"},
      "versionMaterializationOf": {"@id":"ldes:versionMaterializationOf", "@type":"@id"},
      "versionMaterializationUntil": {"@id":"ldes:versionMaterializationUntil","@type":"xsd:dateTime"}
    }
}
